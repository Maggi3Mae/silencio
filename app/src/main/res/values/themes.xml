<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base solo para la ventana; los colores de la app viven en ui/theme. -->
    <style name="Theme.Silencio" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/fondo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
